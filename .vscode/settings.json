{
    "files.associations": {
        "*.css": "css",
        "*.yml": "github-actions-workflow"
    },
    "[github-actions-workflow]": {
        "editor.tabSize": 2
    },
    "eslint.useFlatConfig": true,
    "js/ts.preferences.autoImportFileExcludePatterns": ["node/test.d.ts"],
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "astro"
    ],
    "js/ts.updateImportsOnFileMove.enabled": "prompt",
    "js/ts.preferences.preferTypeOnlyAutoImports": true,
    "js/ts.preferences.importModuleSpecifier": "non-relative",
    "svg.preview.background": "dark-transparent",
    "json5.schemaDownload.trustedDomains": {
        "https://docs.renovatebot.com/": true
    }
}
